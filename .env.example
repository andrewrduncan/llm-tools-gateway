# ---- required ------------------------------------------------------------
# Your OpenAI-compatible model server. Anything implementing
# /v1/chat/completions works.
#   vLLM       http://vllm:8000
#   llama.cpp  http://llamacpp:8001
#   Ollama     http://ollama:11434
UPSTREAM_URL=http://llamacpp:8001

# Public base URL of THIS gateway. Must be reachable from the CLIENT's browser,
# because generated-image URLs are built from it.
GATEWAY_PUBLIC_URL=http://localhost:8000

# ---- behaviour -----------------------------------------------------------
MAX_TOOL_ROUNDS=6
GATEWAY_PROGRESS=1              # stream tool progress via reasoning_content
PROGRESS_HEARTBEAT_SECONDS=10

# Greedy decoding cannot escape a repetition cycle. Applied only when the
# client sets no sampling controls of its own.
DEFAULT_REPETITION_PENALTY=1.1
MIN_TEMPERATURE=0.3

# ---- identity ------------------------------------------------------------
KEYS_FILE=/etc/llm-tools-gateway/keys.json
TRUST_USER_HEADERS=1
USER_ID_HEADERS=x-openwebui-user-id,x-openwebui-user-email,x-user-id

# ---- optional backends (omit any you do not run; its tools disappear) -----
#SEARXNG_URL=http://searxng:8080
#PG_DSN=postgres://llm:password@postgres:5432/llm
#EMBED_URL=http://embeddings:8100
#COMFY_URL=http://comfyui:8188
# Optional. Bind-mount ComfyUI output here so delete_image clears every copy.
#COMFY_OUTPUT_DIR=/comfy-output
#ENABLE_BROWSER=1
#DEFAULT_TZ=America/New_York

# S3-compatible storage for generated images (Garage, MinIO, SeaweedFS, AWS)
#S3_ENDPOINT=http://garage:3900
#S3_BUCKET=images
#S3_KEY_ID=
#S3_SECRET=
#S3_REGION=garage

# ComfyUI workflows -- YOUR exported JSON, see workflows/
#WORKFLOW_DIR=/workflows
#WORKFLOW_GENERATE=generate.json
#WORKFLOW_EDIT=edit.json
